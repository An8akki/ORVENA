# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=2048

# Fallback: Gemini Key 2 (optional - get another free key at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY_2=your-second-gemini-api-key-here

# Fallback: NVIDIA NIM (get free key at https://build.nvidia.com/)
# Uncomment and add your NVIDIA API key to enable
# NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Fallback: OpenAI (get API key at https://platform.openai.com/api-keys)
# Uncomment and add your OpenAI API key to enable
# OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
# OPENAI_MODEL=gpt-4o-mini

# Security
SECRET_KEY=71-0wPjVnJBabB4yjR5hhbcHCwlQhywutCndz0BOtIZg4lAYv86L0BRnbsyMxojJ
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (optional, for caching and background jobs)
# REDIS_URL=redis://localhost:6379/0

# Email (optional, for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@orvena.com

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_CAREER_DISCOVERY=true
ENABLE_RESUME_ANALYSIS=true
ENABLE_JOB_MATCHING=true
ENABLE_INTERVIEW_PREP=true
ENABLE_REGISTRATION=true

# Performance
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Development Tools
ENABLE_API_DOCS=true
ENABLE_CORS_DEBUG=false
