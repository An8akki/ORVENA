# LLM Provider - Multi-Provider Fallback Chain
# ==========================================
# The system will try providers in this order until one succeeds:
# 1. Gemini Key 1 (primary)
# 2. Gemini Key 2 (fallback) - Uncomment to enable
# 3. NVIDIA NIM (fallback) - Uncomment to enable
# 4. OpenAI (fallback) - Uncomment to enable

# Primary: Gemini Key 1 (get free key at https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=2048

# Fallback: Gemini Key 2 (optional - get another free key at https://aistudio.google.com/app/apikey)
# Uncomment and add your second Gemini API key to enable
# GEMINI_API_KEY_2=your-second-gemini-api-key-here

# Fallback: NVIDIA NIM (get free key at https://build.nvidia.com/)
# Uncomment and add your NVIDIA API key to enable
# NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Fallback: OpenAI (get API key at https://platform.openai.com/api-keys)
# Uncomment and add your OpenAI API key to enable
# OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
# OPENAI_MODEL=gpt-4o-mini

# Security
SECRET_KEY=71-0wPjVnJBabB4yjR5hhbcHCwlQhywutCndz0BOtIZg4lAYv86L0BRnbsyMxojJ
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Features
ENABLE_API_DOCS=true
ENABLE_CAREER_DISCOVERY=true
ENABLE_RESUME_ANALYSIS=true
ENABLE_JOB_MATCHING=true
ENABLE_INTERVIEW_PREP=true
ENABLE_REGISTRATION=true
